generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------- Auth.js (NextAuth) required models ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Core domain models ----------

enum Role {
  USER
  MANAGER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  nameChangedAt DateTime? // last time `name` was changed; used to enforce a once-per-month limit
  password      String? // null for OAuth-only accounts
  role          Role      @default(USER)
  walletBalance Int       @default(0) // in BDT (Taka)
  isBlocked     Boolean   @default(false)
  blockedUntil  DateTime? // null while isBlocked = permanent block; future date = temporary
  blockReason   String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  referralCode         String? @unique
  referredById         String?
  referralBonusGranted Boolean @default(false) // set once this user's first completed order has been evaluated for a referral bonus

  signupSource      String? // "Google" | "Facebook" | "Direct" | "Other" — captured once at signup via Referer header
  lastLoginAt       DateTime?
  lastLoginLocation String? // best-effort IP geolocation, e.g. "Dhaka, Bangladesh"
  loginCount        Int       @default(0) // all-time login count — never pruned, unlike loginLogs

  accounts               Account[]
  sessions               Session[]
  orders                 Order[]
  walletTransactions     WalletTransaction[]
  reviewedTransactions   WalletTransaction[] @relation("ReviewedBy")
  reviewedOrders         Order[]             @relation("OrderReviewedBy")
  referredBy             User?               @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals              User[]              @relation("Referrals")
  blogComments           BlogComment[]
  blogLikes              BlogLike[]
  blogCommentLikes       BlogCommentLike[]
  notifications          Notification[]      @relation("UserNotifications")
  sentNotifications      Notification[]      @relation("ActorNotifications")
  loginLogs              LoginLog[]
  reviews                Review[]
  marketListings         MarketListing[]     @relation("MarketListingSeller")
  reviewedMarketListings MarketListing[]     @relation("MarketListingReviewedBy")
  marketOffers           MarketOffer[]       @relation("MarketOfferBuyer")
  respondedMarketOffers  MarketOffer[]       @relation("MarketOfferRespondedBy")
}

// Per-login activity trail — pruned in application code (see recordLoginActivity)
// so at most the most recent 20 rows per user are ever kept.
model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  provider  String // "credentials" | "google"
  ip        String
  location  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Temporary IP blocks for guest (unauthenticated) abuse — script/SQL/shell
// injection attempts or spam from someone with no account to block directly.
model IpBlock {
  id           String   @id @default(cuid())
  ip           String   @unique
  reason       String?  @db.Text
  blockedUntil DateTime
  createdAt    DateTime @default(now())
}

enum ProductType {
  NORMAL
  EXTERNAL_LINK
}

// Admin-managed replacement for the old ProductSection enum (SPECIAL_OFFER/FREE_FIRE)
// — lets an admin add/rename/reorder/delete sections instead of them being hardcoded.
model Section {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  products Product[]
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  slug        String      @unique
  image       String
  sectionId   Int
  type        ProductType @default(NORMAL)
  externalUrl String? // used when type = EXTERNAL_LINK (e.g. Telegram tournament link)
  category    String      @default("Free Fire")
  description String?     @db.Text
  rules       Json? // string[]
  inputLabel  String? // overrides the checkout "Player ID" field label/placeholder for this product; null = default label
  isActive    Boolean     @default(true)
  stockOut    Boolean     @default(false)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  section         Section          @relation(fields: [sectionId], references: [id])
  rechargeOptions RechargeOption[]
  orders          Order[]
  reviews         Review[]

  @@index([sectionId, isActive, sortOrder])
}

enum DeliveryMethod {
  UNIPIN
  SHELL
  MANUAL // no automation — admin fulfills by hand and marks the order DELIVERED
}

model RechargeOption {
  id             Int            @id @default(autoincrement())
  productId      Int
  label          String
  price          Int // in BDT
  stock          Int? // remaining units; null = unlimited (not stock-managed)
  denom          String? // Unipin denom recipe for this option — comma-separated (e.g. "4,4,5") when the pack is fulfilled from multiple smaller vouchers. Only meaningful when deliveryMethod = UNIPIN.
  deliveryMethod DeliveryMethod @default(MANUAL)
  isActive       Boolean        @default(true)
  sortOrder      Int            @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@index([productId])
}

enum PaymentMethod {
  WALLET
  BKASH
  NAGAD
  ROCKET
}

enum OrderStatus {
  PENDING
  APPROVED
  RUNNING // payment approved, Unipin code(s) claimed and topup in flight — awaiting delivery confirmation
  REJECTED
  DELIVERED
  CANCELLED
  AUTO_FAILED // vendor callback (Shell/UniPin) reported status "failed" — set automatically, never by an admin; still retryable by resubmitting APPROVED
}

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique // legacy internal code, kept for backward compatibility — no longer shown in UI
  orderSerial      Int           @unique @default(autoincrement()) // user-facing sequential number, shown as #1, #2, ...
  userId           String? // null for guest orders (see guestName/guestPhone)
  productId        Int
  rechargeOptionId Int
  playerId         String
  playerName       String?
  guestName        String? // set when userId is null (guest checkout)
  guestPhone       String? // set when userId is null (guest checkout)
  amount           Int // in BDT
  paymentMethod    PaymentMethod
  transactionId    String?       @unique // manual gateway trx id, when not paid by wallet
  status           OrderStatus   @default(PENDING)
  adminNote        String?       @db.Text
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  shellClaimedAt DateTime? // set atomically right before calling the Shell API for this order; guards against a second concurrent/retried call. Reset to null on failure so a legitimate retry can re-claim.

  user                User?           @relation(fields: [userId], references: [id])
  product             Product         @relation(fields: [productId], references: [id])
  rechargeOption      RechargeOption  @relation(fields: [rechargeOptionId], references: [id])
  reviewedBy          User?           @relation("OrderReviewedBy", fields: [reviewedById], references: [id])
  redeemedUnipinCodes UnipinCode[]
  apiCallLogs         ApiCallLog[]
  fulfillmentJob      FulfillmentJob?
  usedPaymentSms      PaymentSms?

  @@index([userId])
  @@index([status])
}

enum UnipinCodeStatus {
  UNUSED
  USED
}

// Manually stocked Unipin voucher codes, pooled by `denom` — a plain
// elementary denomination value shared across any RechargeOption whose
// comma-separated `denom` recipe references it. Claimed (status -> USED,
// usedForOrderId set) the moment a FulfillmentJob picks them for an order —
// before the redeem API call, never after (see unipin-queue.ts). `redeemedAt`
// is set only once the UniPin redeem API call for THIS specific code has
// succeeded — a claimed-but-not-yet-redeemed code has usedForOrderId set but
// redeemedAt still null, and a retried job skips calling the API again for
// any code that already has redeemedAt set.
model UnipinCode {
  id             String           @id @default(cuid())
  denom          String
  code           String           @unique
  status         UnipinCodeStatus @default(UNUSED)
  source         String           @default("MANUAL") // "MANUAL" now; an ApiSetting name once fetched automatically
  usedAt         DateTime?
  usedForOrderId String?
  redeemedAt     DateTime? // set once the UniPin redeem API call succeeded for this code
  createdAt      DateTime         @default(now())

  usedForOrder Order? @relation(fields: [usedForOrderId], references: [id], onDelete: SetNull)

  @@index([denom, status])
  @@index([usedForOrderId])
}

enum ApiSettingType {
  UNIPIN
  GARENA_SHELL // legacy/unused value, unrelated to the Shell delivery method below — do not repurpose. Kept for the separate manual GarenaShellAccount vault feature.
  SHELL // automatable Shell top-up API config, used only by orders with RechargeOption.deliveryMethod = SHELL. Fully separate from GARENA_SHELL and from UNIPIN.
  OTHER
}

// Registry of external top-up API credentials, prepared ahead of wiring up
// live automation (see UnipinCode.source). For SHELL rows: endpoint = API URL,
// apiKey = UserID, apiSecret = Password, code = code (spec's 4 Shell fields).
model ApiSetting {
  id        Int            @id @default(autoincrement())
  name      String
  type      ApiSettingType @default(OTHER)
  apiKey    String?        @db.Text
  apiSecret String?        @db.Text
  endpoint  String?
  code      String?        @db.Text // Shell-specific "code" field; unused for UNIPIN/OTHER rows
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())

  apiCallLogs ApiCallLog[]
}

// Allow-list of SMS sender IDs the mobile forwarder app is permitted to
// report (e.g. "bKash", "NAGAD" — carriers/apps vary in casing, so admins
// add each variant they see rather than relying on case-insensitive match).
model SmsSender {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  method    PaymentMethod @default(BKASH)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
}

enum PaymentSmsStatus {
  UNUSED
  USED
}

// A payment transaction extracted from an SMS forwarded by the mobile app.
// Only SMS that (a) come from an allowed SmsSender and (b) match that
// method's payment-notification format get a row here — everything else is
// acknowledged but not stored. `trxId` is unique so re-delivered/duplicate
// SMS from the forwarder app never create a second row.
model PaymentSms {
  id                         Int              @id @default(autoincrement())
  method                     PaymentMethod
  paymentNumber              String
  trxId                      String           @unique
  amount                     Decimal          @db.Decimal(12, 2)
  balance                    Decimal?         @db.Decimal(12, 2)
  status                     PaymentSmsStatus @default(UNUSED)
  // False when SiteSetting.paymentSmsBalanceVerifyEnabled is on and this SMS's
  // reported balance didn't equal checkpoint + amount — still stored/visible
  // in the Store SMS list for admin review, but excluded from auto-matching
  // (claimMatchingPaymentSms/findUnusedPaymentSms) until an admin re-enables it.
  isActive                   Boolean          @default(true)
  usedForOrderId             String?          @unique
  usedForWalletTransactionId String?          @unique
  createdAt                  DateTime         @default(now())

  usedForOrder             Order?             @relation(fields: [usedForOrderId], references: [id], onDelete: SetNull)
  usedForWalletTransaction WalletTransaction? @relation(fields: [usedForWalletTransactionId], references: [id], onDelete: SetNull)

  @@index([method])
  @@index([status])
}

// Raw request/response trail for every external API call made while fulfilling
// an order — kept for debugging when a callback is missing or a code purchase
// fails, per an order stuck in APPROVED. Written via logApiCall() (src/lib/api-log.ts).
model ApiCallLog {
  id             String          @id @default(cuid())
  orderId        String?
  apiSettingId   Int?
  deliveryMethod DeliveryMethod? // UNIPIN or SHELL; null for pre-refactor rows
  denom          String?
  requestBody    String?         @db.Text
  responseBody   String?         @db.Text
  statusCode     Int?
  errorMessage   String?         @db.Text
  success        Boolean         @default(false)
  createdAt      DateTime        @default(now())

  order      Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  apiSetting ApiSetting? @relation(fields: [apiSettingId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

enum FulfillmentJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// The UniPin fulfillment queue. One row per order (orderId is unique — an
// order can never get a second job, so a repeated approval or any other
// retrigger can only ever resume the existing job, never start a parallel
// one). Created the moment an order becomes eligible for UniPin fulfillment;
// processUnipinFulfillmentJob (src/lib/unipin-queue.ts) atomically claims a
// PENDING or FAILED job (status -> PROCESSING) before doing any work, so two
// concurrent process attempts for the same order can never both run.
model FulfillmentJob {
  id           String               @id @default(cuid())
  orderId      String               @unique
  status       FulfillmentJobStatus @default(PENDING)
  attempts     Int                  @default(0)
  lastError    String?              @db.Text
  processingAt DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
}

// Manual login vault for Garena Shell reseller accounts (no public API —
// staff log in by hand), separate from the automatable ApiSetting entries.
model GarenaShellAccount {
  id        String   @id @default(cuid())
  label     String
  accountId String
  password  String
  code      String?
  server    String?
  createdAt DateTime @default(now())
}

enum WalletTransactionType {
  DEPOSIT
  PURCHASE
  REFUND
  ADMIN_ADJUST
  REFERRAL_BONUS
}

enum WalletTransactionStatus {
  PENDING
  APPROVED
  REJECTED
}

model WalletTransaction {
  id            String                  @id @default(cuid())
  userId        String
  type          WalletTransactionType
  method        PaymentMethod           @default(WALLET)
  amount        Int // in BDT, always positive; sign implied by type
  transactionId String? @unique // bKash/Nagad/Rocket trx id submitted by user
  status        WalletTransactionStatus @default(PENDING)
  note          String?                 @db.Text
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime                @default(now())

  user       User  @relation(fields: [userId], references: [id])
  reviewedBy User? @relation("ReviewedBy", fields: [reviewedById], references: [id])
  usedPaymentSms PaymentSms?

  @@index([userId])
  @@index([status])
}

model Banner {
  id        Int      @id @default(autoincrement())
  image     String
  link      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Notice {
  id        Int      @id @default(autoincrement())
  message   String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model BlogPost {
  id              Int      @id @default(autoincrement())
  title           String
  slug            String   @unique
  excerpt         String?  @db.Text
  content         String   @db.Text // Markdown
  coverImage      String?
  metaTitle       String?
  metaDescription String?  @db.Text
  metaKeywords    String?  @db.Text
  isPublished     Boolean  @default(true)
  publishedAt     DateTime @default(now())
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  comments BlogComment[]
  likes    BlogLike[]

  @@index([isPublished, publishedAt])
}

model BlogComment {
  id        String   @id @default(cuid())
  postId    Int
  userId    String
  parentId  String? // set for a reply to a top-level comment (one level deep)
  content   String   @db.Text
  createdAt DateTime @default(now())

  post    BlogPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  BlogComment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies BlogComment[]     @relation("CommentReplies")
  likes   BlogCommentLike[]

  @@index([postId])
  @@index([parentId])
}

model BlogCommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment BlogComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
}

model BlogLike {
  id        String   @id @default(cuid())
  postId    Int
  userId    String
  createdAt DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

// Per-product review, shown on that product's topup page and surfaced to
// Google as Product AggregateRating/Review structured data there. One review
// per user per product — resubmitting edits the existing row rather than
// creating a new one — and every create/edit goes back to isApproved = false
// pending re-moderation.
model Review {
  id         String   @id @default(cuid())
  productId  Int
  userId     String
  rating     Int // 1-5
  comment    String   @db.Text
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, isApproved, createdAt])
}

enum NotificationType {
  COMMENT_REPLY
  COMMENT_LIKE
  ORDER_COMPLETED
  ORDER_NOTE
  ADMIN_ANNOUNCEMENT
  ORDER_FULFILLMENT_ISSUE // admin-only: an order's delivery API failed or had insufficient stock/config
  ORDER_PAYMENT_MISMATCH // admin-only: a matched payment SMS amount didn't equal the order price (over/under-payment)
  PAYMENT_SMS_BALANCE_MISMATCH // admin-only: a forwarded payment SMS's reported balance didn't match checkpoint + amount
}

model Notification {
  id        String           @id @default(cuid())
  userId    String // recipient
  actorId   String? // who triggered it (null for system-generated ones)
  type      NotificationType
  message   String           @db.Text // plain text only — rendered as JSX text, never as HTML
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user  User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

enum MarketListingStatus {
  PENDING
  APPROVED
  REJECTED
  SOLD
}

// Peer-to-peer marketplace where logged-in users list a game account/ID they
// want to sell. Admin moderates every new listing (status starts PENDING) before
// it's publicly visible — see marketEnabled on SiteSetting for the on/off switch
// for the whole feature. No in-app payment/escrow: buyer and seller connect
// directly via the required contactNumber/whatsappNumber (see marketListingFormSchema).
model MarketListing {
  id             String              @id @default(cuid())
  sellerId       String
  game           String
  title          String
  description    String              @db.Text
  price          Int // in BDT
  images         Json // string[] of /uploads paths
  contactNumber  String?
  whatsappNumber String?
  status         MarketListingStatus @default(PENDING)
  adminNote      String?             @db.Text
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  seller     User          @relation("MarketListingSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  reviewedBy User?         @relation("MarketListingReviewedBy", fields: [reviewedById], references: [id])
  offers     MarketOffer[]

  @@index([status, createdAt])
  @@index([sellerId])
}

enum MarketOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// A buyer's price offer on a MarketListing — the in-site "bargain" flow.
// Admin reviews offers (not the seller directly, matching the rest of the
// marketplace's admin-brokered model) and accepts/rejects from /admin/market.
model MarketOffer {
  id            String            @id @default(cuid())
  listingId     String
  buyerId       String
  offerPrice    Int // in BDT
  message       String?           @db.Text
  status        MarketOfferStatus @default(PENDING)
  respondedById String?
  respondedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  listing     MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer       User          @relation("MarketOfferBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  respondedBy User?         @relation("MarketOfferRespondedBy", fields: [respondedById], references: [id])

  @@index([listingId, createdAt])
  @@index([buyerId])
  @@index([status])
}

model SiteSetting {
  id                   Int     @id @default(1)
  siteName             String  @default("TopUpsBD")
  tagline              String  @default("Largest TopUp Site In Bangladesh")
  metaTitle            String? @db.Text
  metaDescription      String? @db.Text
  metaKeywords         String? @db.Text
  ogImage              String?
  favicon              String?
  referralBonusPercent Float   @default(1.5) // % of first order amount credited to both referrer and referred user's wallet
  whatsappNumber       String  @default("01343053411")
  telegramLink         String  @default("https://t.me/+K3PmqW02YCI2OGRl")
  facebookLink         String?
  contactEmail         String  @default("support@topupsbd.com")
  bkashNumber          String  @default("01343053411")
  nagadNumber          String  @default("01343053411")
  rocketNumber         String  @default("01343053411")
  bkashIcon            String?
  nagadIcon            String?
  rocketIcon           String?
  walletIcon           String?
  allowGuestOrders     Boolean @default(false)
  marketEnabled        Boolean @default(true)
  paymentSmsSecret     String? @db.Text // shared secret the mobile SMS-forwarder app must pass as ?secret= to /api/payment-sms

  // When enabled, /api/payment-sms checks each method's running account
  // balance chain (checkpoint + this SMS's amount must equal this SMS's
  // reported balance) before trusting a forwarded payment SMS. Admin sets the
  // starting checkpoint per method on /admin/sms-settings; it then advances
  // automatically after every SMS that verifies cleanly.
  paymentSmsBalanceVerifyEnabled Boolean  @default(false)
  bkashBalanceCheckpoint         Decimal? @db.Decimal(12, 2)
  nagadBalanceCheckpoint         Decimal? @db.Decimal(12, 2)
  rocketBalanceCheckpoint        Decimal? @db.Decimal(12, 2)

  // Master on/off switch + config for outgoing transactional emails (order
  // delivered/cancelled/refund, wallet top-up) — see src/lib/mailer.ts.
  smtpEnabled   Boolean @default(false)
  smtpHost      String?
  smtpPort      Int?    @default(587)
  smtpSecure    Boolean @default(false) // true = implicit TLS (port 465), false = STARTTLS (587)
  smtpUser      String?
  smtpPassword  String? @db.Text
  smtpFromEmail String?
  smtpFromName  String?
}
