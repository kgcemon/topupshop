# Environment variables are loaded via `import "dotenv/config"` in prisma.config.ts
# and via Next.js's built-in .env loading for the app itself.

# ---- Database ----
# Point this at your own MySQL server (local install, XAMPP/WAMP, Docker, or a
# managed provider like PlanetScale / Railway / Aiven). Example for a local server:
DATABASE_URL="mysql://user:password@localhost:3306/topupshop"

# ---- Auth.js (NextAuth v5) ----
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Google OAuth (optional login method). Create credentials at
# https://console.cloud.google.com/apis/credentials — Authorized redirect URI:
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Site ----
NEXT_PUBLIC_SITE_URL="https://topupshop.co"

# ---- Seed / bootstrap admin ----
SEED_ADMIN_EMAIL="admin@topupshop.co"
SEED_ADMIN_PASSWORD="ChangeThisPassword123!"
